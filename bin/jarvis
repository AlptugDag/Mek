#!/bin/bash
# Mek command-line interface
#   mek brifing | durum | piyasa [thy] | izleme [ekle|çıkar] | güvenlik | karantina [geri N] | günlük | temizle [derin] | sus [dakika] | log
#   mek kaldır <Uygulama.app|bundle-id> -> uygulamayı ve ilişkili kullanıcı kalıntılarını kaldırır
#   mek etkinlik [aç|sesli] | çökmeler | güç | disk | ağ [test] | güncelle [...]
SOCK="$HOME/.jarvis/jarvis.sock"
case "$1" in
  kaldır|kaldir|uninstall|remove-app)
    shift
    exec "$HOME/.jarvis/venv/bin/python" "$HOME/.jarvis/jarvisd/app_uninstaller.py" "$@";;
  brifing|durum|yardım|yardim|help|piyasa|borsa|izleme|watchlist|güvenlik|guvenlik|sus|temizle|disk|güç|guc|power|ağ|ag|network|etkinlik|activity|çökmeler|cokmeler|crashes|güncelle|guncelle|update|reklam|adblock|karantina|günlük|gunluk|sor|ask|derin|onay|iptal)
    printf '%s' "$*" | nc -U -w 180 "$SOCK"; echo;;
  log) exec tail -f "$HOME/.jarvis/jarvisd.log";;
  söyle|soyle|say)
    shift; printf 'söyle %s' "$*" | nc -U -w 180 "$SOCK"; echo;;
  *) printf '%s' "$*" | nc -U -w 180 "$SOCK"; echo;;  # serbest soru -> asistan
esac
